#!/bin/bash
set -euo pipefail

cd "$OUTPUT_DIR"

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')

OUTPUTS=$(tofu output -json 2>/dev/null || echo '{}')

TOPIC_ARN=$(echo "$OUTPUTS"  | jq -r '.topic_arn.value  // ""')
TOPIC_NAME=$(echo "$OUTPUTS" | jq -r '.topic_name.value // ""')

for pair in "topic_arn:$TOPIC_ARN" "topic_name:$TOPIC_NAME"; do
  if [ -z "${pair#*:}" ]; then
    echo "ERROR: No ${pair%%:*} output found." >&2
    echo "  Writing the service without it would leave applications with no topic to reach." >&2
    exit 1
  fi
done

ATTRIBUTES=$(jq -n -c \
  --arg topic_arn  "$TOPIC_ARN" \
  --arg topic_name "$TOPIC_NAME" \
  '{
    topic_arn:  $topic_arn,
    topic_name: $topic_name
  }')

echo "Writing service attributes for service ${SERVICE_ID}:"
echo "$ATTRIBUTES" | jq .

np service patch --id "$SERVICE_ID" --body "{\"attributes\": $ATTRIBUTES}"

echo "Service attributes updated."
